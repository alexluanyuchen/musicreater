});

/* =================================
   7. 播放引擎
================================= */

function totalSteps(){
 return getBars()*16;
}

function stepDuration(){
 return 60/getBPM()/4;
}

function allNotes(){
 const result=[];
 state.tracks.forEach((track,trackIndex)=>{
  track.notes.forEach(note=>{
   result.push({track,note,trackIndex});
  });
 });
 return result;
}

function scheduleProject(){
 const ctx=ensureAudio();
 const now=ctx.currentTime+0.08;
 const step=stepDuration();

 state.nodes=[];

 allNotes().forEach(item=>{
  const {track,note}=item;
  const start=now+note.step*step;
  const duration=Math.max(0.04,note.len*step*0.94);
  const output=trackOutput(ctx,track);

  const nodes=scheduleVoice(
   ctx,output,track,note.pitch,start,duration,note.velocity||0.8
  );

  state.nodes.push(...nodes);
 });

 state.startTime=now;
 state.playing=true;
 document.getElementById("playBtn").textContent="Ⅱ 暂停";
 document.getElementById("audioStatus").textContent="● PLAYING";
 updatePosition();
}

function togglePlayback(){
 try{
  if(state.playing){
   if(audioCtx)audioCtx.suspend();
   state.playing=false;
   document.getElementById("playBtn").textContent="▶ 继续";
   document.getElementById("audioStatus").textContent="● PAUSED";
   return;
  }

  if(audioCtx&&audioCtx.state==="suspended"&&state.nodes.length){
   audioCtx.resume();
   state.playing=true;
   document.getElementById("playBtn").textContent="Ⅱ 暂停";
   document.getElementById("audioStatus").textContent="● PLAYING";
   return;
  }

  scheduleProject();
 }catch(e){
  message("播放失败："+e.message);
 }
}

function stopPlayback(){
 if(audioCtx){
  state.nodes.forEach(node=>{
   try{
    if(node.stop)node.stop();
   }catch(e){}
  });
  state.nodes=[];
  audioCtx.resume();
 }
 state.playing=false;
 document.getElementById("playBtn").textContent="▶ 播放";
 document.getElementById("audioStatus").textContent="● READY";
 document.getElementById("position").textContent="小节 1";
}

function playFromStart(){
 stopPlayback();
 scheduleProject();
}

function updatePosition(){
 if(!state.playing)return;
 const elapsed=Math.max(0,audioCtx.currentTime-state.startTime);
 const step=stepDuration();
 const position=Math.min(totalSteps(),Math.floor(elapsed/step));
 document.getElementById("position").textContent=
  "小节 "+(Math.floor(position/16)+1);

 if(position>=totalSteps()){
  stopPlayback();
 }
}

setInterval(updatePosition,100);


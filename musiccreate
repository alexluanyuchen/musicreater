
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
<meta name="theme-color" content="#0b0e16">
<title>MusicStudio Pro</title>
<style>
:root{
 --bg:#0b0e16;--panel:#141925;--panel2:#1b2230;
 --border:#293246;--purple:#9c88ff;--text:#f1f2f8;
 --muted:#8992a6;--green:#55d6a0;
}
*{box-sizing:border-box}
body{
 margin:0;background:var(--bg);color:var(--text);
 font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
}
button,input,select{font:inherit}
button{cursor:pointer}
button:disabled{opacity:.45;cursor:not-allowed}
header{
 height:64px;padding:0 20px;display:flex;align-items:center;
 justify-content:space-between;border-bottom:1px solid var(--border);
 background:#10141e;position:sticky;top:0;z-index:5
}
.logo{font-size:19px;font-weight:850;letter-spacing:-.7px}
.logo span{color:var(--purple)}
.header-right{display:flex;gap:9px;align-items:center}
.status{font-size:11px;color:var(--green)}
.btn{
 border:1px solid var(--border);background:var(--panel2);
 color:white;padding:9px 13px;border-radius:8px;font-size:12px
}
.btn.primary{background:var(--purple);color:#111;border-color:var(--purple);font-weight:750}
.btn.red{background:#482735;color:#ffb8c1}
.btn:hover{filter:brightness(1.15)}
main{padding:17px;max-width:1500px;margin:auto}
.transport{
 background:var(--panel);border:1px solid var(--border);
 padding:12px 15px;border-radius:12px;
 display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:16px
}
.transport button{min-width:38px}
.bigplay{font-size:16px;padding:9px 17px}
.control{display:flex;align-items:center;gap:7px;font-size:12px;color:var(--muted)}
.control input{width:75px}
input,select{
 background:#0d111b;color:white;border:1px solid var(--border);
 border-radius:7px;padding:8px
}
input[type=range]{accent-color:var(--purple);padding:0}
.workspace{
 display:grid;grid-template-columns:225px minmax(0,1fr);
 gap:15px;align-items:start
}
.panel{
 background:var(--panel);border:1px solid var(--border);
 border-radius:12px;padding:15px;min-width:0
}
.panel h3{font-size:14px;margin:0 0 13px}
.section-label{
 font-size:10px;letter-spacing:1px;color:var(--muted);
 margin:17px 0 9px
}
.instrument{
 width:100%;display:flex;align-items:center;gap:10px;
 padding:10px;border:1px solid transparent;
 background:transparent;color:#c4cad8;text-align:left;
 border-radius:8px;font-size:12px;margin-bottom:3px
}
.instrument:hover,.instrument.active{
 background:#292542;border-color:#51477e;color:white
}
.instrument .emoji{font-size:18px;width:25px}
.track-item{
 display:flex;align-items:center;gap:8px;
 padding:9px;background:#101521;border-radius:8px;margin:6px 0
}
.track-item button{
 background:none;border:0;color:white;text-align:left;flex:1;
 font-size:12px;min-width:0
}
.track-item input{width:65px}
.content{min-width:0}
.topinfo{
 display:flex;justify-content:space-between;align-items:center;
 gap:10px;margin-bottom:12px;flex-wrap:wrap
}
.topinfo h2{font-size:17px;margin:0}
.small{font-size:11px;color:var(--muted)}
.roll-wrap{
 overflow:auto;border:1px solid var(--border);
 border-radius:9px;background:#0c1019;
}
.roll{
 min-width:740px;display:grid;
 grid-template-columns:48px repeat(32,minmax(19px,1fr));
 grid-template-rows:repeat(24,27px);
}
.pitch-label{
 display:flex;align-items:center;justify-content:center;
 font-size:10px;color:#929bb0;
 border-right:1px solid #30394b;border-bottom:1px solid #202b3c;
 background:#151b28;position:sticky;left:0;z-index:2
}
.cell{
 border-right:1px solid #1d2635;
 border-bottom:1px solid #202b3c;position:relative;
 cursor:crosshair
}
.cell.barline{border-right:2px solid #536078}
.cell.blackkey{background:#111725}
.cell:hover{background:#282442}
.cell.note{
 background:#8873e5;border-radius:4px;
 box-shadow:inset 0 0 0 1px #c0b3ff
}
.cell.note::after{
 content:"";position:absolute;inset:5px 3px;
 background:rgba(255,255,255,.18);border-radius:2px
}
.cell.selected{background:#d19d56}
.roll-tools{
 display:flex;gap:9px;align-items:center;flex-wrap:wrap;
 margin:13px 0
}
.roll-tools select{font-size:12px}
.keyboard{
 display:flex;gap:3px;overflow:auto;padding:10px 0
}
.key{
 flex:1;min-width:35px;height:65px;border-radius:0 0 6px 6px;
 background:#e8e8ed;color:#20202a;border:1px solid #aaa;
 font-size:10px;display:flex;align-items:end;justify-content:center;
 padding-bottom:7px
}
.key.black{background:#272b38;color:white;height:47px}
.key:active{background:var(--purple)}
.bottom-grid{
 display:grid;grid-template-columns:1fr 1fr;gap:15px;margin-top:15px
}
.mixer-row{
 display:grid;grid-template-columns:100px 1fr 35px;
 align-items:center;gap:9px;margin:11px 0;font-size:11px
}
.mixer-row input{width:100%}
.export-grid{display:flex;flex-wrap:wrap;gap:8px}
.empty{color:var(--muted);font-size:12px;padding:18px;text-align:center}
#message{font-size:12px;color:var(--green);min-height:18px;margin-top:9px}
footer{text-align:center;color:#606a7d;font-size:10px;padding:25px}
@media(max-width:850px){
 .workspace{grid-template-columns:1fr}
 .instrument-list{display:grid;grid-template-columns:repeat(2,1fr);gap:4px}
 .instrument{margin:0}
 .bottom-grid{grid-template-columns:1fr}
}
@media(max-width:480px){
 main{padding:10px}
 header{padding:0 12px}
 .logo{font-size:16px}
 .header-right .status{display:none}
 .panel{padding:12px}
 .transport{gap:7px;padding:10px}
}
</style>
</head>
<body>

<header>
 <div class="logo">MUSIC<span>STUDIO</span> PRO</div>
 <div class="header-right">
  <span class="status" id="audioStatus">● AUDIO ENGINE READY</span>
  <button class="btn" onclick="newProject()">新建工程</button>
 </div>
</header>

<main>
 <section class="transport">
  <button class="btn primary bigplay" id="playBtn" onclick="togglePlayback()">▶ 播放</button>
  <button class="btn red" onclick="stopPlayback()">■ 停止</button>
  <button class="btn" onclick="playFromStart()">↺ 从头播放</button>
  <div class="control">BPM
   <input type="number" id="bpm" value="120" min="40" max="240">
  </div>
  <div class="control">拍号
   <select id="meter"><option value="4">4/4</option><option value="3">3/4</option><option value="6">6/8</option></select>
  </div>
  <div class="control">总小节
   <select id="bars">
    <option>2</option><option selected>4</option>
    <option>8</option><option>16</option>
   </select>
  </div>
  <span class="small" id="position">小节 1</span>
 </section>

 <div class="workspace">
  <aside class="panel">
   <h3>🎹 乐器库</h3>
   <div class="section-label">INSTRUMENTS</div>
   <div class="instrument-list" id="instrumentList"></div>

   <div class="section-label">TRACKS / 音轨</div>
   <div id="trackList"></div>
   <button class="btn" style="width:100%;margin-top:8px" onclick="addTrack()">＋ 添加当前乐器音轨</button>
  </aside>

  <section class="content">
   <div class="panel">
    <div class="topinfo">
     <div>
      <h2>钢琴卷帘 Piano Roll</h2>
      <div class="small" id="activeInfo">当前音轨：钢琴</div>
     </div>
     <div class="small">点击网格添加音符 · 点击已有音符删除</div>
    </div>

    <div class="roll-tools">
     <label class="small">音符长度</label>
     <select id="noteLength">
      <option value="1">1/16</option>
      <option value="2" selected>1/8</option>
      <option value="4">1/4</option>
      <option value="8">1/2</option>
     </select>
     <label class="small">音高范围</label>
     <select id="octave">
      <option value="60">C4–B5</option>
      <option value="48">C3–B4</option>
      <option value="72">C5–B6</option>
     </select>
     <button class="btn" onclick="clearTrack()">清空当前音轨</button>
    </div>

    <div class="roll-wrap">
     <div class="roll" id="roll"></div>
    </div>

    <div class="small" style="margin-top:9px">
     横向为时间，纵向为音高。每小节16个格子。
    </div>
   </div>

   <div class="panel" style="margin-top:15px">
    <h3>🎹 虚拟键盘 · 实时演奏</h3>
    <div class="small">点击琴键播放音符，也可以使用电脑键盘 A–K 演奏。</div>
    <div class="keyboard" id="keyboard"></div>
   </div>

   <div class="bottom-grid">
    <div class="panel">
     <h3>🎚️ 混音控制台</h3>
     <div id="mixer"></div>
     <div class="small">音量控制为每条音轨独立设置。</div>
    </div>
    <div class="panel">
     <h3>📁 项目与导出</h3>
     <div class="export-grid">
      <button class="btn" onclick="saveProject()">保存工程</button>
      <button class="btn" onclick="loadProject()">打开工程</button>
      <button class="btn" onclick="exportMIDI()">导出 MIDI</button>
      <button class="btn primary" onclick="exportWAV()">导出 WAV</button>
      <button class="btn" onclick="exportMP3()">导出 MP3</button>
     </div>
     <div id="message"></div>
     <div class="small" style="margin-top:12px;line-height:1.8">
      MIDI：保存音符数据。<br>
      WAV：离线渲染完整工程。<br>
      MP3：使用 LAME 编码器转换 WAV 音频。
     </div>
    </div>
   </div>
  </section>
 </div>
</main>

<footer>
 MUSICSTUDIO PRO · WEB AUDIO WORKSTATION · 1.0
</footer>

<input id="projectFile" type="file" accept=".json,application/json" hidden>

<script>
"use strict";

/* =================================
   1. 乐器配置
================================= */

const INSTRUMENTS=[
 {name:"钢琴",emoji:"🎹",type:"piano",wave:"triangle"},
 {name:"电子合成器",emoji:"🎛️",type:"synth",wave:"sawtooth"},
 {name:"吉他",emoji:"🎸",type:"guitar",wave:"triangle"},
 {name:"贝斯",emoji:"🎸",type:"bass",wave:"sawtooth"},
 {name:"鼓组",emoji:"🥁",type:"drums",wave:"sine"},
 {name:"小提琴",emoji:"🎻",type:"violin",wave:"sawtooth"},
 {name:"弦乐",emoji:"🎻",type:"strings",wave:"sawtooth"},
 {name:"长笛",emoji:"🪈",type:"flute",wave:"sine"},
 {name:"管弦乐",emoji:"🎼",type:"orchestra",wave:"sawtooth"},
 {name:"萨克斯",emoji:"🎷",type:"sax",wave:"sawtooth"}
];

const state={
 bpm:120,
 bars:4,
 tracks:[],
 activeTrack:0,
 playing:false,
 startTime:0,
 startOffset:0,
 nodes:[],
 master:null,
 ctx:null,
 timer:null,
 reverb:null
};

let audioCtx=null;
let offlineMode=false;
let selectedLength=2;

/* =================================
   2. 工程初始化
================================= */

function makeTrack(type){
 const ins=INSTRUMENTS.find(x=>x.type===type)||INSTRUMENTS[0];
 return {
  id:crypto.randomUUID(),
  name:ins.name,
  type:ins.type,
  volume:0.8,
  pan:0,
  muted:false,
  notes:[]
 };
}

state.tracks=[makeTrack("piano")];

function message(text){
 document.getElementById("message").textContent=text;
}

function currentTrack(){
 return state.tracks[state.activeTrack];
}

function getBPM(){
 return Math.max(40,Math.min(240,Number(document.getElementById("bpm").value)||120));
}

function getBars(){
 return Number(document.getElementById("bars").value)||4;
}

document.getElementById("bpm").addEventListener("change",()=>{
 state.bpm=getBPM();
});

document.getElementById("bars").addEventListener("change",()=>{
 state.bars=getBars();
 renderRoll();
});

/* =================================
   3. 音频引擎
================================= */

function ensureAudio(){
 if(!audioCtx){
  const AC=window.AudioContext||window.webkitAudioContext;
  if(!AC)throw new Error("浏览器不支持 Web Audio API");
  audioCtx=new AC();
  state.ctx=audioCtx;

  state.master=audioCtx.createGain();
  state.master.gain.value=0.85;

  const compressor=audioCtx.createDynamicsCompressor();
  compressor.threshold.value=-18;
  compressor.ratio.value=3;

  state.reverb=audioCtx.createConvolver();
  state.reverb.buffer=createImpulse(audioCtx,1.5,2.2);

  const wet=audioCtx.createGain();
  wet.gain.value=0.18;

  state.master.connect(compressor);
  compressor.connect(audioCtx.destination);

  state.reverb.connect(wet);
  wet.connect(compressor);
 }
 if(audioCtx.state==="suspended")audioCtx.resume();
 return audioCtx;
}

function createImpulse(ctx,seconds,decay){
 const length=ctx.sampleRate*seconds;
 const buffer=ctx.createBuffer(2,length,ctx.sampleRate);
 for(let c=0;c<2;c++){
  const data=buffer.getChannelData(c);
  for(let i=0;i<length;i++){
   data[i]=(Math.random()*2-1)*Math.pow(1-i/length,decay);
  }
 }
 return buffer;
}

function midiFrequency(midi){
 return 440*Math.pow(2,(midi-69)/12);
}

function trackOutput(ctx,track){
 const gain=ctx.createGain();
 gain.gain.value=track.muted?0:track.volume;
 const pan=ctx.createStereoPanner();
 pan.pan.value=track.pan||0;
 gain.connect(pan);

 if(ctx===audioCtx&&state.reverb){
  const send=ctx.createGain();
  send.gain.value=0.12;
  gain.connect(state.reverb);
 }
 pan.connect(ctx===audioCtx?state.master:ctx.destination);
 return gain;
}

/* 生成打击乐器声音 */
function drumSound(ctx,dest,midi,time,duration,volume){
 const gain=ctx.createGain();
 gain.gain.value=volume;
 gain.connect(dest);

 if(midi===36){
  const osc=ctx.createOscillator();
  osc.type="sine";
  osc.frequency.setValueAtTime(140,time);
  osc.frequency.exponentialRampToValueAtTime(42,time+0.18);
  gain.gain.setValueAtTime(volume,time);
  gain.gain.exponentialRampToValueAtTime(0.001,time+0.3);
  osc.connect(gain);
  osc.start(time);
  osc.stop(time+0.31);
  return [osc,gain];
 }

 const length=Math.max(1,Math.floor(ctx.sampleRate*0.18));
 const buffer=ctx.createBuffer(1,length,ctx.sampleRate);
 const data=buffer.getChannelData(0);
 for(let i=0;i<length;i++)data[i]=Math.random()*2-1;

 const noise=ctx.createBufferSource();
 noise.buffer=buffer;

 const filter=ctx.createBiquadFilter();
 filter.type="highpass";
 filter.frequency.value=midi===42?7000:1000;

 gain.gain.setValueAtTime(volume,time);
 gain.gain.exponentialRampToValueAtTime(0.001,time+0.17);

 noise.connect(filter);
 filter.connect(gain);
 noise.start(time);
 noise.stop(time+0.18);
 return [noise,filter,gain];
}

/* 通用合成乐器声音 */
function scheduleVoice(ctx,dest,track,midi,time,duration,velocity=0.8){
 if(track.muted)return [];
 if(track.type==="drums"){
  return drumSound(ctx,dest,midi,time,duration,velocity*track.volume);
 }

 const freq=midiFrequency(midi);
 const type=track.type;
 const masterGain=ctx.createGain();
 const filter=ctx.createBiquadFilter();

 let attack=0.015;
 let release=0.12;
 let waveform="triangle";

 if(type==="piano"){
  waveform="triangle";attack=0.004;release=0.25;
  filter.type="lowpass";filter.frequency.value=7000;
 }
 if(type==="synth"){
  waveform="sawtooth";attack=0.01;release=0.2;
  filter.type="lowpass";filter.frequency.value=4500;
 }
 if(type==="guitar"){
  waveform="triangle";attack=0.003;release=0.18;
  filter.type="lowpass";filter.frequency.value=3500;
 }
 if(type==="bass"){
  waveform="sawtooth";attack=0.008;release=0.12;
  filter.type="lowpass";filter.frequency.value=900;
 }
 if(type==="violin"){
  waveform="sawtooth";attack=0.18;release=0.3;
  filter.type="lowpass";filter.frequency.value=5000;
 }
 if(type==="strings"){
  waveform="sawtooth";attack=0.25;release=0.4;
  filter.type="lowpass";filter.frequency.value=4500;
 }
 if(type==="flute"){
  waveform="sine";attack=0.09;release=0.2;
  filter.type="lowpass";filter.frequency.value=6000;
 }
 if(type==="orchestra"){
  waveform="sawtooth";attack=0.12;release=0.35;
  filter.type="lowpass";filter.frequency.value=4000;
 }
 if(type==="sax"){
  waveform="sawtooth";attack=0.07;release=0.22;
  filter.type="lowpass";filter.frequency.value=3000;
 }

 filter.Q.value=0.7;

 const amp=velocity*track.volume*(type==="piano"?0.18:0.13);
 const end=time+Math.max(0.04,duration);

 masterGain.gain.setValueAtTime(0.0001,time);
 masterGain.gain.linearRampToValueAtTime(amp,time+attack);
 masterGain.gain.setValueAtTime(amp,end);
 masterGain.gain.exponentialRampToValueAtTime(0.0001,end+release);

 const oscillators=[];

 function osc(freqValue,wave,volume){
  const o=ctx.createOscillator();
  const g=ctx.createGain();
  o.type=wave;
  o.frequency.setValueAtTime(freqValue,time);
  g.gain.value=volume;
  o.connect(g);
  g.connect(filter);
  o.start(time);
  o.stop(end+release+0.02);
  oscillators.push(o);
 }

 osc(freq,waveform,1);

 if(["piano","guitar","strings","orchestra","violin"].includes(type)){
  osc(freq*2,waveform,0.20);
 }
 if(type==="sax"){
  osc(freq*2.01,"square",0.12);
 }
 if(type==="orchestra"){
  osc(freq*0.997,"triangle",0.18);
 }
 if(type==="strings"||type==="violin"){
  osc(freq*1.004,"triangle",0.14);
 }

 filter.connect(masterGain);
 masterGain.connect(dest);

 return [...oscillators,filter,masterGain];
}

/* =================================
   4. 乐器选择和音轨
================================= */

function renderInstrumentList(){
 const box=document.getElementById("instrumentList");
 box.innerHTML="";
 INSTRUMENTS.forEach(ins=>{
  const btn=document.createElement("button");
  btn.className="instrument";
  btn.innerHTML='<span class="emoji">'+ins.emoji+'</span>'+ins.name;
  btn.onclick=()=>{
   addTrackOf(ins.type);
  };
  box.appendChild(btn);
 });
}

function addTrackOf(type){
 const track=makeTrack(type);
 state.tracks.push(track);
 state.activeTrack=state.tracks.length-1;
 renderAll();
}

function addTrack(){
 addTrackOf(INSTRUMENTS[0].type);
}

function selectTrack(index){
 state.activeTrack=index;
 renderAll();
}

function renderTracks(){
 const box=document.getElementById("trackList");
 box.innerHTML="";

 state.tracks.forEach((track,index)=>{
  const row=document.createElement("div");
  row.className="track-item";

  const btn=document.createElement("button");
  btn.textContent=(index+1)+". "+track.name;
  btn.onclick=()=>selectTrack(index);

  if(index===state.activeTrack){
   row.style.outline="1px solid #8876d8";
  }

  const mute=document.createElement("button");
  mute.textContent=track.muted?"M":"●";
  mute.style.cssText="flex:0;width:24px;color:"+(track.muted?"#ff9aa5":"#70d6a7");
  mute.onclick=()=>{
   track.muted=!track.muted;
   renderAll();
  };

  const del=document.createElement("button");
  del.textContent="×";
  del.style.cssText="flex:0;width:20px;color:#ff9aa5";
  del.onclick=()=>{
   if(state.tracks.length===1){
    alert("至少保留一条音轨");
    return;
   }
   state.tracks.splice(index,1);
   state.activeTrack=Math.max(0,Math.min(state.activeTrack,state.tracks.length-1));
   renderAll();
  };

  row.append(btn,mute,del);
  box.appendChild(row);
 });
}

function renderMixer(){
 const box=document.getElementById("mixer");
 box.innerHTML="";

 state.tracks.forEach((track,index)=>{
  const row=document.createElement("div");
  row.className="mixer-row";

  const name=document.createElement("span");
  name.textContent=track.name;

  const slider=document.createElement("input");
  slider.type="range";
  slider.min=0;
  slider.max=1;
  slider.step=0.01;
  slider.value=track.volume;

  slider.oninput=()=>{
   track.volume=Number(slider.value);
   value.textContent=Math.round(track.volume*100);
  };

  const value=document.createElement("span");
  value.textContent=Math.round(track.volume*100);

  row.append(name,slider,value);
  box.appendChild(row);
 });
}

/* =================================
   5. 钢琴卷帘
================================= */

const PITCH_NAMES=["C","C#","D","D#","E","F","F#","G","G#","A","A#","B"];

function pitchName(midi){
 return PITCH_NAMES[midi%12]+(Math.floor(midi/12)-1);
}

function renderRoll(){
 const roll=document.getElementById("roll");
 roll.innerHTML="";

 const base=Number(document.getElementById("octave").value);
 const total=getBars()*16;
 roll.style.gridTemplateColumns="48px repeat("+total+",minmax(19px,1fr))";

 const track=currentTrack();
 if(!track)return;

 document.getElementById("activeInfo").textContent=
  "当前音轨："+track.name+" · "+track.notes.length+" 个音符";

 for(let row=0;row<24;row++){
  const midi=base+23-row;
  const label=document.createElement("div");
  label.className="pitch-label";
  label.style.gridColumn="1";
  label.style.gridRow=String(row+1);
  label.textContent=pitchName(midi);
  roll.appendChild(label);

  for(let col=0;col<total;col++){
   const cell=document.createElement("div");
   cell.className="cell";
   if(col%16===15)cell.classList.add("barline");
   if(PITCH_NAMES[midi%12].includes("#"))cell.classList.add("blackkey");

   cell.style.gridColumn=String(col+2);
   cell.style.gridRow=String(row+1);

   const note=track.notes.find(n=>
    n.pitch===midi&&col>=n.step&&col<n.step+n.len
   );

   if(note){
    cell.classList.add("note");
    if(col===note.step)cell.title="点击删除音符";
   }

   cell.onclick=()=>{
    const existing=track.notes.find(n=>
     n.pitch===midi&&col>=n.step&&col<n.step+n.len
    );

    if(existing){
     track.notes=track.notes.filter(n=>n!==existing);
    }else{
     const len=Number(document.getElementById("noteLength").value);
     track.notes.push({
      pitch:midi,step:col,len:Math.min(len,total-col),velocity:0.8
     });
    }
    renderRoll();
   };

   roll.appendChild(cell);
  }
 }
}

document.getElementById("octave").addEventListener("change",renderRoll);
document.getElementById("noteLength").addEventListener("change",()=>{
 selectedLength=Number(document.getElementById("noteLength").value);
});


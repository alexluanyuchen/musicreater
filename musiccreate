 if(!file)return;

 try{
  const data=JSON.parse(await file.text());

  if(data.app!=="MusicStudio Pro"||!Array.isArray(data.tracks)){
   throw new Error("不是有效的 MusicStudio Pro 工程");
  }

  if(data.tracks.length>50)throw new Error("音轨数量异常");

  data.tracks.forEach(track=>{
   if(!Array.isArray(track.notes))throw new Error("音符数据无效");
   track.notes.forEach(note=>{
    if(
     !Number.isFinite(note.pitch)||note.pitch<0||note.pitch>127||
     !Number.isFinite(note.step)||note.step<0||
     !Number.isFinite(note.len)||note.len<1
    )throw new Error("音符数据无效");
   });
  });

  stopPlayback();
  state.tracks=data.tracks;
  state.bpm=Math.max(40,Math.min(240,Number(data.bpm)||120));
  state.bars=Math.max(1,Math.min(64,Number(data.bars)||4));

  document.getElementById("bpm").value=state.bpm;
  document.getElementById("bars").value=state.bars;
  document.getElementById("meter").value=data.meter||"4";

  state.activeTrack=0;
  renderAll();
  message("工程加载成功！");
 }catch(err){
  alert("工程读取失败："+err.message);
 }finally{
  e.target.value="";
 }
});

/* =================================
   9. MIDI 文件导出
================================= */

function vlq(value){
 let buffer=value&0x7f;
 const result=[];
 while((value>>=7)){
  buffer<<=8;
  buffer|=((value&0x7f)|0x80);
 }
 while(true){
  result.push(buffer&255);
  if(buffer&0x80)buffer>>=8;
  else break;
 }
 return result;
}

function ascii(s){
 return Array.from(s).map(c=>c.charCodeAt(0));
}

function u32(n){
 return [(n>>>24)&255,(n>>>16)&255,(n>>>8)&255,n&255];
}

function u16(n){
 return [(n>>>8)&255,n&255];
}

function makeTrackChunk(track){
 const events=[];
 const ppq=480;
 const stepTicks=ppq/4;

 events.push({tick:0,order:0,data:[0xff,0x03,...vlq(track.name.length),...ascii(track.name)]});

 track.notes.forEach(note=>{
  const start=note.step*stepTicks;
  const end=(note.step+note.len)*stepTicks;
  const velocity=Math.round((note.velocity||0.8)*100);

  events.push({
   tick:start,order:1,
   data:[0x90,note.pitch,velocity]
  });
  events.push({
   tick:end,order:0,
   data:[0x80,note.pitch,0]
  });
 });

 events.sort((a,b)=>a.tick-b.tick||a.order-b.order);

 const bytes=[];
 let previous=0;

 events.forEach(ev=>{
  bytes.push(...vlq(ev.tick-previous),...ev.data);
  previous=ev.tick;
 });

 bytes.push(0,0xff,0x2f,0);
 return [...ascii("MTrk"),...u32(bytes.length),...bytes];
}

function exportMIDI(){
 const bpm=getBPM();
 const tempo=Math.round(60000000/bpm);

 const tempoTrack=[
  ...ascii("MTrk"),...u32(15),
  0,0xff,0x51,3,
  (tempo>>16)&255,(tempo>>8)&255,tempo&255,
  0,0xff,0x2f,0
 ];

 const tracks=state.tracks.map(makeTrackChunk);
 const header=[
  ...ascii("MThd"),...u32(6),...u16(1),
  ...u16(tracks.length+1),...u16(480)
 ];

 const all=[...header,...tempoTrack,...tracks];

 downloadBlob(new Blob([new Uint8Array(all)],{type:"audio/midi"}),"MusicStudio-Project.mid");
 message("MIDI 导出完成。");
}

/* =================================
   10. WAV 离线导出
================================= */

function floatTo16BitPCM(view,offset,input){
 for(let i=0;i<input.length;i++,offset+=2){
  const s=Math.max(-1,Math.min(1,input[i]));
  view.setInt16(offset,s<0?s*32768:s*32767,true);
 }
}

function audioBufferToWav(buffer){
 const channels=buffer.numberOfChannels;
 const sampleRate=buffer.sampleRate;
 const samples=buffer.length;
 const bytesPerSample=2;
 const blockAlign=channels*bytesPerSample;
 const dataSize=samples*blockAlign;

 const array=new ArrayBuffer(44+dataSize);
 const view=new DataView(array);

 function writeString(offset,string){
  for(let i=0;i<string.length;i++){
   view.setUint8(offset+i,string.charCodeAt(i));
  }
 }

 writeString(0,"RIFF");
 view.setUint32(4,36+dataSize,true);
 writeString(8,"WAVE");
 writeString(12,"fmt ");
 view.setUint32(16,16,true);
 view.setUint16(20,1,true);
 view.setUint16(22,channels,true);
 view.setUint32(24,sampleRate,true);
 view.setUint32(28,sampleRate*blockAlign,true);
 view.setUint16(32,blockAlign,true);
 view.setUint16(34,16,true);
 writeString(36,"data");
 view.setUint32(40,dataSize,true);

 const left=buffer.getChannelData(0);
 const right=channels>1?buffer.getChannelData(1):left;

 let offset=44;
 for(let i=0;i<samples;i++){
  view.setInt16(offset,Math.max(-32768,Math.min(32767,left[i]*32767)),true);
  offset+=2;
  if(channels>1){
   view.setInt16(offset,Math.max(-32768,Math.min(32767,right[i]*32767)),true);
   offset+=2;
  }
 }
 return array;
}

async function renderOffline(){
 const Offline=window.OfflineAudioContext||window.webkitOfflineAudioContext;
 if(!Offline)throw new Error("浏览器不支持离线音频渲染");

 const bpm=getBPM();
 const secondsPerStep=60/bpm/4;
 const duration=totalSteps()*secondsPerStep+2;

 const sampleRate=44100;
 const length=Math.ceil(duration*sampleRate);
 const offline=new Offline(2,length,sampleRate);

 const compressor=offline.createDynamicsCompressor();
 compressor.connect(offline.destination);

 const reverb=offline.createConvolver();
 reverb.buffer=createImpulse(offline,1.2,2.4);
 const wet=offline.createGain();
 wet.gain.value=0.12;
 reverb.connect(wet);
 wet.connect(compressor);

 state.tracks.forEach(track=>{
  const output=offline.createGain();
  output.gain.value=track.muted?0:track.volume;
  output.connect(compressor);
  output.connect(reverb);

  track.notes.forEach(note=>{
   scheduleVoice(
    offline,output,track,note.pitch,
    note.step*secondsPerStep,
    note.len*secondsPerStep*0.94,
    note.velocity||0.8
   );
  });
 });

 return await offline.startRendering();
}

async function exportWAV(){
 try{
  message("正在渲染 WAV，请稍候...");
  const buffer=await renderOffline();
  const wav=audioBufferToWav(buffer);

  downloadBlob(
   new Blob([wav],{type:"audio/wav"}),
   "MusicStudio-Export.wav"
  );
  message("WAV 导出完成！");
 }catch(e){
  message("导出失败："+e.message);
 }
}

/* =================================
   11. MP3 编码
================================= */

async function loadLame(){
 if(window.lamejs)return window.lamejs;

 await new Promise((resolve,reject)=>{
  const script=document.createElement("script");
  script.src="https://cdn.jsdelivr.net/npm/lamejs@1.2.1/lame.min.js";
  script.onload=resolve;
  script.onerror=()=>reject(new Error("MP3 编码库加载失败，请检查网络"));
  document.head.appendChild(script);
 });

 if(!window.lamejs)throw new Error("MP3 编码库未能启动");
 return window.lamejs;
}

async function exportMP3(){
 try{
  message("正在加载 MP3 编码器...");
  const lame=await loadLame();

  message("正在渲染音乐...");
  const buffer=await renderOffline();

  const left=buffer.getChannelData(0);
  const right=buffer.numberOfChannels>1?
   buffer.getChannelData(1):left;

  const encoder=new lame.Mp3Encoder(2,buffer.sampleRate,192);
  const block=1152;
  const chunks=[];

  const left16=new Int16Array(left.length);
  const right16=new Int16Array(right.length);

  for(let i=0;i<left.length;i++){
   left16[i]=Math.max(-32768,Math.min(32767,left[i]*32767));
   right16[i]=Math.max(-32768,Math.min(32767,right[i]*32767));
  }

  for(let i=0;i<left.length;i+=block){
   const l=left16.subarray(i,i+block);
   const r=right16.subarray(i,i+block);
   const result=encoder.encodeBuffer(l,r);
   if(result.length)chunks.push(new Uint8Array(result));
  }

  const end=encoder.flush();
  if(end.length)chunks.push(new Uint8Array(end));

  downloadBlob(
   new Blob(chunks,{type:"audio/mpeg"}),
   "MusicStudio-Export.mp3"
  );
  message("MP3 导出完成！");
 }catch(e){
  message("MP3 导出失败："+e.message);
 }
}

